{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{
			"source": "/resume",
			"destination": "https://marlonbaatjes.vercel.app/resume",
			"permanent": false
		},
		{
			"source": "/projects/:path*",
